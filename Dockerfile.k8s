# syntax=docker/dockerfile:1
# Jenkins(k3s dind)용 전체 빌드 이미지: 프론트엔드 정적 빌드 + Go 단일 바이너리 컴파일 후 상류 런타임 이미지 규격으로 패키징.
FROM golang:1.26-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends rsync curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src/

# 1) Next.js 정적 내보내기 (devDependencies 포함: NODE_ENV=production 이면 모듈 누락)
WORKDIR /src/web
ENV NPM_CONFIG_CACHE=/tmp/.npm
# dind 네트워크가 불안정해 npm ci 자체 재시도
RUN npm ci --include=dev --fetch-retries=5 --fetch-retry-maxtimeout=120000 || \
    (sleep 15 && npm ci --include=dev --fetch-retries=5 --fetch-retry-maxtimeout=120000) || \
    (sleep 45 && npm ci --include=dev --fetch-retries=5 --fetch-retry-maxtimeout=120000)
RUN NEXT_EXPORT=1 npm run build

# 2) 프론트엔드를 서버에 임베드하고 단일 바이너리 컴파일
WORKDIR /src
RUN mkdir -p server/webui/dist && \
    rsync -a --delete web/out/ server/webui/dist/ && \
    CGO_ENABLED=0 go build -tags embedui -o dist/amd64/artex ./cmd/artex

# 런타임: 상류 Dockerfile과 동일 (npm 네트워크 flaky → 재시도 루프)
FROM python:3.12-slim-trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN for i in 1 2 3 4 5; do \
      npm install -g --fetch-retries=5 --fetch-retry-maxtimeout=120000 npm@12.2.1 && break; \
      sleep 20; \
    done && \
    test "$(npm --version)" = "12.2.1" && \
    for i in 1 2 3 4 5; do \
      npm install -g --fetch-retries=5 --fetch-retry-maxtimeout=120000 \
        @playwright/mcp@latest @playwright/cli@latest playwright@latest && break; \
      sleep 20; \
    done && \
    playwright-cli --help && \
    playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*

# npm 12.2.1 bundles vulnerable undici 6.29.0; replace it with the patched release.
RUN set -eux; \
    npm_dir="$(npm root -g)/npm"; \
    undici_dir="$npm_dir/node_modules/undici"; \
    test "$(node -p "require('$npm_dir/package.json').version")" = "12.2.1"; \
    curl -fsSL https://registry.npmjs.org/undici/-/undici-6.29.1.tgz -o /tmp/undici-6.29.1.tgz; \
    echo "12f46552dfd0a8012f5dd41e44c6147f0390b1fce90f3b7292b1b6a3018413fac1381a18bfdb85dfd673b0d0e1e254c51e14ebd973998ca91882e783d7666618  /tmp/undici-6.29.1.tgz" | sha512sum -c -; \
    rm -rf "$undici_dir"; \
    mkdir -p "$undici_dir"; \
    tar -xzf /tmp/undici-6.29.1.tgz --strip-components=1 -C "$undici_dir"; \
    test "$(node -p "require('$undici_dir/package.json').version")" = "6.29.1"; \
    test "$(npm --version)" = "12.2.1"; \
    rm -f /tmp/undici-6.29.1.tgz

WORKDIR /app
COPY --from=builder /src/dist/amd64/artex /app/artex
COPY start.sh /app/start.sh
RUN chmod +x /app/artex /app/start.sh
COPY skills/ /app/skills/
VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787"]
